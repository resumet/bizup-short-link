{
  "name": "bzup-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bootstrap": "node --env-file=.env.local scripts/bootstrap.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:seed": "node --env-file=.env.local scripts/dev-seed.mjs",
    "dev:staff": "node --env-file=.env.local scripts/dev-staff.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:cleanup": "node --env-file=.env.local scripts/cleanup.mjs",
    "db:migrate:prod": "node --env-file=.env.vercel --env-file=.env.prod-admin scripts/migrate.mjs",
    "bootstrap:prod": "node --env-file=.env.vercel --env-file=.env.prod-admin scripts/bootstrap.mjs",
    "types": "node --env-file=.env.local scripts/link-types.mjs",
    "types:prod": "node --env-file=.env.vercel --env-file=.env.prod-admin scripts/link-types.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "exceljs": "^4.4.0",
    "next": "15.5.29",
    "postgres": "^4.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^19.0.0-beta.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
