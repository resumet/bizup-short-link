# BZUP Link 환경변수 템플릿 — 실제 비밀값은 커밋하지 않는다.
# 서버 전용 값은 NEXT_PUBLIC_ 접두사를 쓰지 않는다 (브라우저로 전달 금지).

# --- 업무 DB (Supabase PostgreSQL, 서버 전용) ---
# Vercel 서버리스에서는 Supabase transaction pooler(6543) 주소를 사용한다. prepared statement 는 코드에서 끈다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# --- Supabase Auth (BFF: 서버에서만 사용) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
SUPABASE_SECRET_KEY=<secret-or-service-role-key>

# --- 서비스 주소 정책 (§20.4) ---
# 운영 서비스·코드 원장의 고정 식별자. 도메인 연결·재배포로 바꾸지 않는다.
SERVICE_NAMESPACE_ID=00000000-0000-4000-8000-000000000000
# 최초 등록용 HTTPS Production 주소. 서비스 설정이 이미 있으면 사용하지 않는다.
INITIAL_PRIMARY_ORIGIN=https://<your-project>.vercel.app
# 최초 owner 로 지정할, 배포 시 확인한 Supabase Auth 사용자 UUID (첫 가입자 자동 승격 없음)
INITIAL_OWNER_USER_ID=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_NAME=최고관리자
WORKSPACE_NAME=비즈업

# --- API 키 환경: live(운영) / test(분리된 개발·Preview) ---
BZUP_KEY_ENV=live

# --- 독립 코드 예약 원장 (§15.8) ---
# 운영: s3 (DB 복원과 독립, If-None-Match 조건부 신규 쓰기). 개발: postgres
CODE_LEDGER_DRIVER=s3
CODE_LEDGER_BUCKET=bzup-link-code-ledger
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 만료 기록 정리 (Vercel Cron 인증, 16자 이상) ---
CRON_SECRET=
